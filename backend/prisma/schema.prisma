generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetKind {
  IMAGE
  PROJECT_PDF
  RESUME
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique @db.VarChar(80)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String    @map("admin_user_id")
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  ip               String?   @db.VarChar(120)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model SiteProfile {
  id            Int               @id @default(1)
  name          String            @db.VarChar(120)
  tagline       String            @db.VarChar(240)
  resumeAssetId String?           @unique @map("resume_asset_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  contacts      SiteContactItem[]
  resumeAsset   Asset?            @relation("ProfileResume", fields: [resumeAssetId], references: [id], onDelete: SetNull)

  @@map("site_profiles")
}

model SiteContactItem {
  id            String      @id @default(cuid())
  siteProfileId Int         @map("site_profile_id")
  label         String      @db.VarChar(80)
  value         String      @db.VarChar(160)
  href          String      @db.VarChar(500)
  order         Int         @default(100)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  siteProfile   SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)

  @@index([siteProfileId, order])
  @@map("site_contact_items")
}

model Asset {
  id              String         @id @default(cuid())
  kind            AssetKind
  fileName        String         @map("file_name") @db.VarChar(255)
  originalName    String         @map("original_name") @db.VarChar(255)
  mimeType        String         @map("mime_type") @db.VarChar(120)
  size            Int
  storageProvider String         @default("local") @map("storage_provider") @db.VarChar(40)
  objectKey       String         @map("object_key") @db.VarChar(500)
  url             String         @db.VarChar(500)
  previewUrl      String?        @map("preview_url") @db.VarChar(500)
  checksum        String?        @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  profileResume   SiteProfile?   @relation("ProfileResume")
  projectCovers   Project[]      @relation("ProjectCover")
  projectPdfs     Project[]      @relation("ProjectPdf")
  projectImages   ProjectImage[]

  @@index([kind])
  @@map("assets")
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(160)
  title        String        @db.VarChar(160)
  excerpt      String        @db.VarChar(500)
  description  String        @db.Text
  period       String        @db.VarChar(80)
  role         String?       @db.VarChar(160)
  highlights   Json
  notes        Json
  coverAssetId String?       @map("cover_asset_id")
  pdfAssetId   String?       @map("pdf_asset_id")
  sortOrder    Int           @default(100) @map("sort_order")
  status       ProjectStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  coverAsset   Asset?        @relation("ProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  pdfAsset     Asset?        @relation("ProjectPdf", fields: [pdfAssetId], references: [id], onDelete: SetNull)
  images       ProjectImage[]
  links        ProjectLink[]

  @@index([status, sortOrder])
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  assetId   String   @map("asset_id")
  caption   String?  @db.VarChar(240)
  order     Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([projectId, order])
  @@map("project_images")
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  label     String   @db.VarChar(80)
  url       String   @db.VarChar(500)
  order     Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@map("project_links")
}
